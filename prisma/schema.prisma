generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Msisdn {
  id             Int       @id @default(autoincrement())
  msisdn         String
  sn             String
  slotSimbank    Int       @map("slot_simbank")
  linkCekKuota   String    @map("link_cek_kuota")
  noDus          String    @map("no_dus")
  kuota          Float     @default(0)
  usedQuota      Float     @default(0) @map("used_quota")
  remainingQuota Float     @default(0) @map("remaining_quota")
  city           String    @default("All Location")
  lastScrapedAt  DateTime? @map("last_scraped_at")
  isExhausted    Boolean   @default(false) @map("is_exhausted")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([msisdn])
  @@map("msisdn")
}

model ActivityLog {
  id               Int                @id @default(autoincrement())
  recordedAt       DateTime           @default(now()) @map("recorded_at")
  totalSimCards    Int                @map("total_sim_cards")
  statusActive     Int                @map("status_active")
  statusHabis      Int                @map("status_habis")
  newlyExhausted   Int                @map("newly_exhausted")
  scrapeTotal      Int                @default(0) @map("scrape_total")
  scrapeSuccess    Int                @default(0) @map("scrape_success")
  scrapeFailed     Int                @default(0) @map("scrape_failed")
  cityBreakdown    ActivityLogCity[]
  scrapeFailures   ScrapeFailure[]

  @@map("activity_log")
}

model ActivityLogCity {
  id              Int         @id @default(autoincrement())
  activityLogId   Int         @map("activity_log_id")
  activityLog     ActivityLog @relation(fields: [activityLogId], references: [id], onDelete: Cascade)
  city            String
  newlyExhausted  Int         @map("newly_exhausted")

  @@map("activity_log_city")
}

model ScrapeFailure {
  id              Int         @id @default(autoincrement())
  activityLogId   Int         @map("activity_log_id")
  activityLog     ActivityLog @relation(fields: [activityLogId], references: [id], onDelete: Cascade)
  msisdn          String      @default("")
  url             String
  errorMessage    String      @map("error_message")
  createdAt       DateTime    @default(now()) @map("created_at")

  @@map("scrape_failure")
}
